unit U_Utils_Functional;

{ U_Utils_Functional.pas in Delf (4 Nov). The generic routines are free functions, as the
  comments in Problem_1_2.dpr call them: ZipTransform(data1, counts, mult), not
  UFP.ZipTransform<integer, integer, integer>(…). delfc puts them on a record in the output,
  and infers their type arguments at each call. The .pas stays for the Delphi programs.

  Unlike the .pas, List_Reduce always starts from the value it is given: the .pas used it only
  when T was an integer type (gettypekind) and began every other T at Default(T). }

interface
uses Generics.Collections, Generics.Defaults, System.SysUtils, System.Classes, System.Math;

const
    minint = -maxint;
type
    tuple <A>     = record fst : A;
                           snd : A;
                           constructor Create(_a,_b:A);         overload;
                           constructor Create(arr:TArray<A>);   overload;
                    end;
    tuple <A,B>   = record fst : A;
                           snd : B;
                           constructor Create(_a:A; _b:B);
                    end;
    triple<A,B,C> = record fst : A; snd : B; thd : C; end;

    TupleInt      = tuple<integer>;
    TupleStr      = tuple<string>;

    TupleInt_Comp_Fst = class(TComparer<TupleInt>)
    public
      function Compare(const L,R: TupleInt): integer; override;
    end;

    TupleInt_Comp_Snd = class(TComparer<TupleInt>)
    public
      function Compare(const L,R: TupleInt): integer; override;
    end;


  function List_Map    <U>     ( L : TStringList; f : TFunc<string,U> )  : TList<U>;    overload;
  function List_Map    <T,U>   ( L : TList<T>;    f : TFunc<T,U> )       : TList<U>;    overload;

  function String_Map  <U>     ( const s: string; f : TFunc<string, integer, U> )
                                                                       : TList<U>;

  function List_Reduce <T>     ( L : TList<T>;    f : TFunc<T,T,T>; t_:T): T;           overload;
  function List_Reduce <T>     ( L : TList<T>;    f : TFunc<T,T,T> )     : T;           overload;

  function List_Filter <T>     ( L : TList<T>;    f : TPredicate<T> )    : TList<T>;

  function Compose  <T,U,V>    ( f : TFunc<T,U>;  g : TFunc<U,V> )       : TFunc<T,V>;
  function Compose3 <T,U,V,W>  ( f : TFunc<T,U>;
                                 g : TFunc<U,V>;  h : TFunc<V,W> )       : TFunc<T,W>;

  function Zip         <T,U>   ( L1 : TList<T>;   L2 : TList<U> )        : TList< tuple<T,U> >;
  function ZipTransform<T,U,V> ( L1 : TList<T>;
                                 L2 : TList<U>;   f  : TFunc<T,U,V> )    : TList<V>;    overload;
  function ZipTransform<T,U,V> ( L1 : TArray<T>;
                                 L2 : TArray<U>;  f  : TFunc<T,U,V> )    : TList<V>;    overload;

  function Order       <T>     ( L  : TList<T> )                         : TList<T>;

  function Adj_Diff            ( A  : TArray<integer> )                  : TList<integer>;
  function Adj_Delta           ( A  : TArray<integer> )                  : TList<integer>;

  function Take        <T>     ( L  : TList<T>;   n  : integer )         : TList<T>;
  function Leave       <T>     ( L  : TList<T>;   n  : integer )         : TList<T>;

  function Make_Tuple  <A,B>   ( t  : tuple<B>;   f  : TFunc<B,A>)       : tuple<A>;


  function SafeStrToInt(s : string)  : integer;

  function StringToInt (s : string ) : integer;

  function Sum      ( i,j : integer) : integer;

  function Diff     ( i,j : integer) : integer;

  function Delta    ( i,j : integer) : integer;

  function Mult     ( i,j : integer) : integer;

  function Max      ( i,j : integer) : integer;

  function Min      ( i,j : integer) : integer;

  function To_Int     ( s : string ) : integer;

  function To_Str    ( i : integer ) : string;

  function AddTuple  ( t1, t2 : TupleInt) : TupleInt;

implementation
   constructor tuple<A>.Create(_a,_b:A);
   begin
        fst := _a;
        snd := _b;
   end;

   constructor tuple<A>.Create(arr:TArray<A>);
   begin
        fst := arr[0];
        snd := arr[1];
   end;


   constructor tuple<A,B>.Create(_a: A; _b: B);
   begin
        fst := _a;
        snd := _b;
   end;

   function TupleInt_Comp_Fst.Compare(const L,R: TupleInt): Integer;
   begin
        Exit( L.fst - R.fst );
   end;

   function TupleInt_Comp_Snd.Compare(const L,R: TupleInt): Integer;
   begin
        Exit( L.snd - R.snd );
   end;


   function List_Map<T,U> ( L : TList<T>; f : TFunc<T,U> ) : TList<U>;
   begin
     L2 ← TList<U>.create;

         for var T_ in L do L2.Add( f(T_) );

         Exit( L2 );
   end;


   function List_Map<U> ( L : TStringList; f : TFunc<string,U> ) : TList<U>;
   begin
     L2 ← TList<U>.create;

         for var T_ in L do L2.Add( f(T_) );

         Exit( L2 );
   end;


   function String_Map<U> ( const s : string; f : TFunc<string, integer, U> ) : TList<U>;
   begin
     L2 ← TList<U>.create;

         for var i := 1 to length(s) do L2.Add( f(s, i) );

         Exit( L2 );
   end;


   function List_Reduce<T> ( L : TList<T>; f : TFunc<T,T,T>; t_:T ) : T;
   begin
         result := t_;
         for var x in L do result := f(x, result);
   end;


   function List_Reduce<T> ( L : TList<T>; f : TFunc<T,T,T> ) : T;
   begin
         Exit( List_Reduce<T>(L, f, Default(T)) );
   end;



   function List_Filter<T> ( L : TList<T>; f : TPredicate<T> ) : TList<T>;
   begin
     L2 ← TList<T>.create;

         for var T_ in L do if f(T_) then L2.Add(T_);

         Exit( L2 );
   end;



   function Compose <T,U,V> ( f : TFunc<T,U>; g : TFunc<U,V> ) : TFunc<T,V>;
   begin
         Exit( λ(_t: T) -> g( f( _t ) ) );
   end;



   function Compose3 <T,U,V,W> ( f : TFunc<T,U>; g : TFunc<U,V>; h : TFunc<V,W> ) : TFunc<T,W>;
   begin
         Exit( λ(_t: T) -> h( g( f( _t ) ) ) );
   end;


   function Zip <T,U> ( L1:TList<T>; L2:TList<U> ) : TList< tuple<T,U> >;
   begin
     L3 ← TList< tuple<T,U> >.create;
     var i  := 0;

         if L1.Count = L2.Count then
            while i<L1.Count do begin
                  L3.Add( tuple<T,U>.Create( L1[i], L2[i] ) );
                  inc(i);
            end;
         Exit( L3 );
   end;


   function ZipTransform <T,U,V> ( L1:TList<T>;
                                   L2:TList<U>; f:TFunc<T,U,V> ) : TList<V>;
   begin
     L3 ← TList<V>.create;
     var i  := 0;

         if L1.Count = L2.Count then
            while i<L1.Count do begin
                  L3.Add( f(L1[i],L2[i]) );
                  inc(i);
            end;
         Exit( L3 );
   end;


   function ZipTransform <T,U,V> ( L1:TArray<T>;
                                   L2:TArray<U>; f:TFunc<T,U,V> ) : TList<V>;
   begin
     L3 ← TList<V>.create;
     var i  := 0;

         if length(L1) = length(L2) then
            while i<length(L1) do begin
                  L3.Add( f(L1[i],L2[i]) );
                  inc(i);
            end;
         Exit( L3 );
   end;


   function Order <T> ( L:TList<T> ) : TList<T>;
   begin
         L.Sort;
         Exit( L );
   end;


   function Adj_Diff ( A:TArray<integer> ) : TList<integer>;
   begin
     L ← TList<integer>.create;
     var last := 0;

         for var x in A do begin
             L.Add( x-last );
             last := x;
         end;
         Exit( L );
   end;


   function Adj_Delta ( A:TArray<integer> ) : TList<integer>;
   begin
     L ← TList<integer>.create;
     var last := 0;

         for var x in A do begin
             L.Add( abs(x-last) );
             last := x;
         end;
         Exit( L );
   end;


   function Take <T> ( L:TList<T>; n:integer ) : TList<T>;
   begin
     L_ ← TList<T>.create;
     k  ← min(n,L.Count);

         for var i:=0 to k-1 do L_.Add(L[i]);

         Exit( L_ );
   end;


   function Leave <T> ( L:TList<T>; n:integer ) : TList<T>;
   begin
     L_ ← TList<T>.create;

         for var i:=n to L.Count-1 do L_.Add(L[i]);

         Exit( L_ );
   end;


   function Make_tuple<A,B>( t:tuple<B>; f:TFunc<B,A> ) : tuple<A>;
   begin
        result.fst := f(t.fst);
        result.snd := f(t.snd);
   end;

// - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -

   function SafeStrToInt(   s : string ) : integer;   begin  if s='' then exit(0) else exit(s.ToInteger)  end;

   function StringToInt (   s : string ) : integer;   begin  exit( s.ToInteger ) end;

   function Sum         ( i,j : integer) : integer;   begin  exit( i+j )         end;

   function Diff        ( i,j : integer) : integer;   begin  exit( i-j )         end;

   function Delta       ( i,j : integer) : integer;   begin  exit( abs(i-j) )    end;

   function Mult        ( i,j : integer) : integer;   begin  exit( i*j )         end;

   function Max         ( i,j : integer) : integer;   begin  if i<j then exit(j) else exit(i)  end;

   function Min         ( i,j : integer) : integer;   begin  if i<j then exit(i) else exit(j)  end;

  function To_Int         ( s : string ) : integer;   begin exit( s.ToInteger ); end;

  function To_Str         ( i : integer) : string;    begin exit( i.ToString );  end;

  function AddTuple  ( t1, t2 : TupleInt) : TupleInt;
  begin
           result.fst := t1.fst + t2.fst;
           result.snd := t1.snd + t2.snd;
  end;

end.
